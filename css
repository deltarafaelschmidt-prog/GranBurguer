body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #1a1a1a;
    color: #f2f2f2;
}

header {
    background-color: #8b0000;
    padding: 25px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 34px;
    letter-spacing: 2px;
}

.banner {
    background-image: linear-gradient(
        rgba(0,0,0,0.5),
        rgba(0,0,0,0.5)
    ),
    url('../img/banner.jpeg');

    background-size: cover;
    background-position: center;
    height: 350px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.banner h2 {
    background-color: rgba(0,0,0,0.6);
    padding: 20px 40px;
    border-radius: 10px;
    font-size: 30px;
}

.cardapio {
    padding: 40px;
    max-width: 900px;
    margin: auto;
}

.cardapio h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 32px;
    color: #ffcc66;
}

.item {
    background-color: #2b2b2b;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 25px;
    display: flex;
    gap: 20px;
    border: 1px solid #444;
}

.item img {
    width: 160px;
    border-radius: 10px;
}

.item h3 {
    margin: 0;
    font-size: 26px;
    color: #ffcc66;
}

.whatsapp {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background-color: #25d366;
    padding: 15px 20px;
    border-radius: 50px;
    color: white;
    font-weight: bold;
    text-decoration: none;
    box-shadow: 0 0 10px black;
}
